{
  "name": "miraepass",
  "private": true,
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "admin",
    "docs",
    "api-client"
  ],
  "scripts": {
    "postinstall": "test ! -e .git || yarn hooks:install || echo '[경고] Git 훅 설치 실패: uv 설치 후 yarn hooks:install을 실행하세요.'",
    "hooks:install": "uv run --project server pre-commit install",
    "run:docker": "docker compose -f docker/docker-compose.dev.yml up --remove-orphans",
    "dev:client": "yarn workspace scfs-miraepass-front dev",
    "dev:admin": "yarn workspace scfs-miraepass-dashboard dev",
    "dev:docs": "yarn workspace scfs-miraepass-docs dev",
    "build:client": "yarn workspace scfs-miraepass-front build",
    "build:admin": "yarn workspace scfs-miraepass-dashboard build",
    "build:docs": "yarn workspace scfs-miraepass-docs build",
    "typecheck:client": "yarn workspace scfs-miraepass-front nuxt typecheck",
    "typecheck:admin": "yarn workspace scfs-miraepass-dashboard typecheck",
    "typecheck": "uv run --project server pre-commit run -a",
    "sdk-gen": "yarn workspace @miraepass/api-client sdk-gen"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9",
    "semver": "^7.8.5"
  },
  "resolutions": {
    "nextra/zod": "4.3.6",
    "nextra-theme-docs/zod": "4.3.6"
  }
}
