# SCFS Mirae Pass Backend - Environment Configuration
# Copy this file to .env and modify

# ===========================================
# Optional Settings
# ===========================================
ALLOWED_ORIGINS=*


# ===========================================
# Database Settings
# ===========================================
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_USERNAME=miraepass
DB_DATABASE_NAME=miraepass
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DATABASE_URL=
# REDIS_URL=

# ===========================================
# Service Settings
# ===========================================

## Session
# SERVICE_SESSION_COOKIE_NAME=session_id
# SERVICE_SESSION_EXPIRE_SECONDS=604800

## NEIS (출석체크 학사일정 조회, 없으면 출석체크 API가 503으로 응답)
# OFFICE_CODE: 시도교육청코드 (예: 전라남도교육청 Q10), SCHOOL_CODE: 행정표준코드
# NEIS={"API_KEY": "", "OFFICE_CODE": "Q10", "SCHOOL_CODE": ""}
